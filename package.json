    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@use-gesture/react": "^10.3.1",
    "approve": "^0.0.12",
    "better-sqlite3": "^13.0.3",
    "camera-controls": "^3.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
