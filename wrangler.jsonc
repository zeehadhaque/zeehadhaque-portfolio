{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeehad-haque-filmmaker",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "vars": {
    "TURSO_DATABASE_URL": "file:local.db"
  }
}
